                                  await loadWorkspace(
                                    Number(
                                      selectedWorkspace.id,
                                    ),
                                  );

                                  setMessage(
                                    `${member.username} promoted.`,
                                  );
                                } catch (err) {
                                  setError(
                                    err instanceof Error
                                      ? err.message
                                      : "Unable to promote member.",
