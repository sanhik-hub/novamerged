  color: #8298ba;
}

.workspace-v4-question-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.workspace-v4-problem-card {
  min-height: 190px;
  padding: 20px;
  border-radius: 19px;
  background:
    radial-gradient(circle at 100% 0%, rgba(90, 130, 255, 0.1), transparent 38%),
    rgba(12, 18, 30, 0.75);
}

.workspace-v4-problem-card h3 {
  min-height: 64px;
  margin: 18px 0;
  color: #edf3ff;
  line-height: 1.45;
}

.workspace-problem-topline,
.workspace-problem-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.workspace-problem-topline {
  color: #74849e;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.workspace-problem-footer {
  padding-top: 13px;
  border-top: 1px solid rgba(150, 180, 230, 0.08);
  color: #71839f;
  font-size: 12px;
}

.workspace-problem-footer b {
  color: #a9c5ff;
}

.workspace-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(2, 5, 11, 0.72);
  backdrop-filter: blur(10px);
}

.workspace-v4-modal,
.workspace-question-window,
.workspace-solve-window,
.workspace-v4-attempt-window {
  width: min(720px, 100%);
  max-height: min(820px, calc(100vh - 48px));
  overflow: auto;
  border: 1px solid rgba(145, 180, 245, 0.17);
  border-radius: 22px;
  background:
    radial-gradient(circle at 85% 0%, rgba(80, 125, 245, 0.1), transparent 32%),
    #0c121e;
  color: #e8eef9;
  box-shadow: 0 30px 100px rgba(0,0,0,.45);
}

.workspace-question-window,
.workspace-solve-window {
  width: min(900px, 100%);
}

.workspace-v4-attempt-window {
  width: min(820px, 100%);
}

.workspace-modal-header,
.workspace-attempt-window-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  padding: 21px 23px;
  border-bottom: 1px solid rgba(145, 180, 245, 0.1);
}

.workspace-modal-header h2,
.workspace-attempt-window-header h2 {
  margin: 5px 0 0;
  color: #f2f6ff;
}

.workspace-modal-close {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border: 1px solid rgba(150, 180, 230, 0.12);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: #8ea0bb;
  font-size: 21px;
  cursor: pointer;
}

.workspace-modal-close:hover {
  color: #fff;
  background: rgba(255,255,255,.07);
}

.workspace-modal-body {
  padding: 23px;
}

.workspace-modal-description {
  margin: 0 0 19px;
  color: #8291a8;
  line-height: 1.6;
}

.workspace-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 15px;
}

.workspace-field > span {
  color: #a7b6cc;
  font-size: 12px;
  font-weight: 700;
}

.workspace-field input,
.workspace-field textarea,
.workspace-field select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(145, 175, 225, 0.15);
  border-radius: 12px;
  background: #111927;
  color: #e8eef8;
  padding: 12px 13px;
  outline: none;
}

.workspace-field input::placeholder,
.workspace-field textarea::placeholder {
  color: #60708a;
}

.workspace-field input:focus,
.workspace-field textarea:focus,
.workspace-field select:focus {
  border-color: rgba(125, 165, 255, .45);
  box-shadow: 0 0 0 3px rgba(100, 145, 255, .08);
}

.workspace-field textarea {
  resize: vertical;
  line-height: 1.5;
}

.workspace-field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.workspace-modal-actions,
.workspace-question-actions,
.workspace-finished-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 20px;
}

.workspace-question-window-body,
.workspace-solution-content {
  padding: 23px;
}

.workspace-question-prompt {
  padding: 20px;
  border: 1px solid rgba(140, 175, 230, .1);
  border-radius: 17px;
  background: rgba(255,255,255,.022);
}

.workspace-question-prompt > div:last-child {
  margin-top: 18px;
  color: #edf3ff;
  font-size: 20px;
  line-height: 1.6;
}

.workspace-gemini-panel {
  margin-top: 13px;
  padding: 15px;
  border: 1px solid rgba(110, 155, 250, .14);
  border-radius: 16px;
  background: rgba(65, 105, 190, .06);
}

.workspace-gemini-panel > div:first-child {
  display: flex;
  align-items: center;
  gap: 10px;
}

.workspace-gemini-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(100, 145, 255, .14);
  color: #bcd2ff;
  font-weight: 900;
}

.workspace-gemini-panel strong,
.workspace-gemini-panel small {
  display: block;
}

.workspace-gemini-panel strong {
  color: #e7efff;
}

.workspace-gemini-panel small {
  margin-top: 3px;
  color: #788aa5;
}

.workspace-question-actions {
  justify-content: flex-start;
}

.workspace-permission-note {
  display: block;
  margin-top: 11px;
  color: #c79a6b;
  line-height: 1.5;
}

.workspace-attempt-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 13px;
}

.workspace-attempt-summary > div {
  padding: 14px;
  border-radius: 14px;
  border: 1px solid rgba(140, 175, 230, .09);
  background: rgba(255,255,255,.02);
}

.workspace-attempt-summary strong,
.workspace-attempt-summary small {
  display: block;
}

.workspace-attempt-summary strong {
  margin-top: 5px;
  color: #edf3ff;
}

.workspace-attempt-summary small {
  margin-top: 3px;
  color: #71829c;
}

.workspace-v4-follow-up {
  margin-top: 13px;
  padding: 17px;
  border-radius: 16px;
  border: 1px solid rgba(110, 155, 245, .13);
  background: rgba(80, 120, 210, .045);
}

.workspace-v4-follow-up h3 {
  margin: 4px 0 12px;
  color: #edf3ff;
}

.workspace-v4-follow-up textarea {
  width: 100%;
  box-sizing: border-box;
  resize: vertical;
  border: 1px solid rgba(140, 175, 230, .13);
  border-radius: 12px;
  background: #101827;
  color: #e8eef8;
  padding: 12px;
}

.workspace-v4-follow-up > button {
  margin-top: 9px;
}

.workspace-solution-primary {
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(145, 180, 230, .09);
}

.workspace-solution-question {
  margin-top: 13px;
  padding: 16px;
  border-radius: 14px;
  background: rgba(255,255,255,.025);
  color: #eef4ff;
  font-size: 18px;
  line-height: 1.6;
}

.workspace-solution-options {
  display: grid;
  gap: 7px;
  margin-top: 12px;
}

.workspace-solution-option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 11px;
  border: 1px solid rgba(140, 175, 230, .09);
  border-radius: 11px;
  background: rgba(255,255,255,.018);
  color: #9eacc0;
}

.workspace-solution-option > span:first-child {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 7px;
  background: rgba(130, 160, 220, .1);
  color: #9fb8e8;
  font-size: 11px;
  font-weight: 800;
}

.workspace-solution-option.correct {
  border-color: rgba(100, 205, 145, .22);
  background: rgba(80, 170, 115, .07);
  color: #d7f4e1;
}

.workspace-solution-option.correct > span:first-child {
  background: rgba(90, 190, 130, .16);
  color: #9be0b5;
}

.workspace-solution-hint {
  margin-top: 11px;
  padding: 12px 14px;
  border-left: 2px solid rgba(120, 165, 250, .4);
  background: rgba(90, 130, 220, .05);
}

.workspace-solution-hint strong {
  color: #abc7ff;
}

.workspace-solution-hint p {
  margin: 5px 0 0;
  color: #8a9ab2;
  line-height: 1.55;
}

.workspace-solution-section-heading {
  padding: 20px 0 10px;
}

.workspace-solution-section-heading h3 {
  margin: 5px 0;
  color: #edf3ff;
}

.workspace-solution-section-heading p {
  margin: 0;
  color: #7788a1;
}

.workspace-generated-question-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.workspace-generated-question {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 13px;
  padding: 15px;
  border: 1px solid rgba(140, 175, 230, .09);
  border-radius: 15px;
  background: rgba(255,255,255,.018);
}

.workspace-generated-number {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: rgba(100, 140, 230, .1);
  color: #a8c2f5;
  font-weight: 800;
}

.workspace-generated-question > div:last-child > strong {
  display: block;
  color: #e9f0fc;
  line-height: 1.5;
}

.workspace-solution-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  padding-top: 15px;
  border-top: 1px solid rgba(145, 180, 230, .09);
}

.workspace-solution-footer > span {
  color: #71839e;
  font-size: 12px;
}

.workspace-attempt-progress {
  padding: 20px 23px 0;
}

.workspace-attempt-progress > div:first-child {
  display: flex;
  justify-content: space-between;
  color: #dce6f7;
  font-size: 13px;
}

.workspace-attempt-progress small {
  color: #71839d;
}

.workspace-attempt-progress-track {
  height: 5px;
  margin-top: 9px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(120, 150, 200, .12);
}

.workspace-attempt-progress-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #759cff, #a67cff);
}

.workspace-v4-attempt-question {
  margin: 22px 23px 17px;
  padding: 21px;
  border-radius: 17px;
  border: 1px solid rgba(145, 180, 235, .1);
  background: rgba(255,255,255,.025);
  color: #f0f5ff;
  font-size: 21px;
  line-height: 1.65;
}

.workspace-question-label {
  display: block;
  margin-bottom: 12px;
  color: #7d91b1;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
}

.workspace-v4-attempt-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  padding: 0 23px;
}

.workspace-v4-attempt-options button {
  min-height: 76px;
  display: grid;
  grid-template-columns: 35px 1fr 20px;
  align-items: center;
  gap: 11px;
  padding: 11px;
  border: 1px solid rgba(145, 175, 225, .12);
  border-radius: 14px;
  background: rgba(255,255,255,.018);
  color: #cbd6e8;
  text-align: left;
  cursor: pointer;
  transition: .16s ease;
}

.workspace-v4-attempt-options button:hover {
  border-color: rgba(130, 165, 245, .3);
  background: rgba(90, 130, 220, .07);
}

.workspace-v4-attempt-options button.selected {
  border-color: rgba(125, 165, 255, .55);
  background: rgba(90, 130, 230, .13);
  box-shadow: 0 0 0 2px rgba(100, 145, 255, .06);
}

.workspace-option-letter {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: rgba(120, 150, 210, .1);
  color: #a9c3f5;
  font-weight: 800;
}

.workspace-v4-attempt-options button.selected .workspace-option-letter {
  background: rgba(110, 150, 255, .2);
  color: #d5e2ff;
}

.workspace-option-content {
  min-width: 0;
  color: #d7e0ee;
  line-height: 1.5;
}

.workspace-option-check {
  color: #93b7ff;
  font-weight: 900;
}

.workspace-v4-hint {
  margin: 13px 23px 0;
  padding: 13px 15px;
  border-radius: 13px;
  background: rgba(110, 150, 240, .06);
  border: 1px solid rgba(120, 165, 245, .12);
}

.workspace-v4-hint p {
  margin: 5px 0 0;
  color: #92a2ba;
  line-height: 1.55;
}

.workspace-attempt-window-actions {
  padding: 20px 23px 23px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.workspace-v4-attempt-finished {
  padding: 42px 23px;
  text-align: center;
}

.workspace-v4-attempt-finished h3 {
  margin: 12px 0 5px;
  color: #f1f5ff;
  font-size: 25px;
}

.workspace-v4-attempt-finished p {
  color: #8798b0;
}

.workspace-score-orb {
  width: 90px;
  height: 90px;
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  border-radius: 50%;
  border: 1px solid rgba(130, 165, 255, .3);
  background: rgba(90, 130, 230, .11);
  color: #dce7ff;
  font-size: 28px;
  font-weight: 800;
  box-shadow: 0 0 40px rgba(80, 130, 255, .12);
}

.workspace-finished-actions {
  justify-content: center;
}

.workspace-v4-members .workspace-member-list {
  display: grid;
  gap: 8px;
}

.workspace-v4-member-item {
  padding: 13px 15px;
  border: 1px solid rgba(140, 175, 230, .09);
  border-radius: 14px;
  background: rgba(255,255,255,.018);
}

.workspace-member-avatar {
  width: 40px;
  height: 40px;
}

.workspace-v4-invitation-item {
  padding: 17px;
  border: 1px solid rgba(140, 175, 230, .1);
  border-radius: 15px;
  background: rgba(255,255,255,.018);
}

.workspace-v4-invitation-item strong {
  display: block;
  margin: 5px 0;
  color: #edf3ff;
}

.workspace-v4-invitation-item span:not(.eyebrow) {
  color: #8292a9;
}

.workspace-v4 .workspace-empty {
  color: #8292a9;
  background: rgba(255,255,255,.015);
  border-color: rgba(140, 175, 230, .08);
}

.workspace-v4 .workspace-empty strong {
  color: #dce6f5;
}

.workspace-v4 .workspace-empty span {
  color: #73849d;
}

@media (max-width: 1100px) {
  .workspace-landing-grid,
  .workspace-v4-question-grid {
    grid-template-columns: 1fr;
  }

  .workspace-command-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .workspace-v4-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .workspace-header-actions {
    justify-content: flex-start;
  }

  .workspace-hero-card {
    padding: 25px;
  }

  .workspace-v4-shell {
    grid-template-columns: 1fr;
  }

  .workspace-v4-sidebar {
    position: static;
  }

  .workspace-sidebar-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .workspace-command-grid,
  .workspace-v4-stats,
  .workspace-v4-attempt-options,
  .workspace-field-grid,
  .workspace-attempt-summary {
    grid-template-columns: 1fr;
  }

  .workspace-dashboard-heading,
  .workspace-section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .workspace-modal-overlay {
    padding: 10px;
  }

  .workspace-v4-modal,
  .workspace-question-window,
  .workspace-solve-window,
  .workspace-v4-attempt-window {
    max-height: calc(100vh - 20px);
    border-radius: 18px;
  }
}
