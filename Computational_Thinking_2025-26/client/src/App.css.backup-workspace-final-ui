/* ---------------------------------------------------------------
   Attempt window
   --------------------------------------------------------------- */

.workspace-attempt-overlay {
  position: fixed;
  inset: 0;
  z-index: 1500;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(0,0,0,.72);
  backdrop-filter: blur(14px);
}

.workspace-attempt-window {
  width: min(760px,100%);
  max-height: calc(100dvh - 40px);
  overflow-y: auto;
  padding: 25px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 20px;
  background:
    radial-gradient(circle at 100% 0%,rgba(110,90,255,.12),transparent 38%),
    rgba(18,18,23,.98);
  color: var(--text);
  box-shadow: 0 35px 100px rgba(0,0,0,.58);
}

.workspace-attempt-window-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.workspace-attempt-window-header h2 {
  margin: 5px 0 0;
  font-size: 24px;
  letter-spacing: -.035em;
}

.workspace-attempt-progress {
  margin-bottom: 16px;
}

.workspace-attempt-progress > span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 10px;
}

.workspace-attempt-progress > div {
  height: 4px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255,255,255,.08);
}

.workspace-attempt-progress i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width .2s ease;
}

.workspace-attempt-question {
  padding: 21px;
  border: 1px solid rgba(255,255,255,.075);
  border-radius: 14px;
  background: rgba(255,255,255,.025);
  font-size: 17px;
  line-height: 1.65;
}

.workspace-attempt-options {
  display: grid;
  gap: 8px;
  margin-top: 13px;
}

.workspace-attempt-options button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 50px;
  padding: 9px 11px;
  border: 1px solid rgba(255,255,255,.075);
  border-radius: 10px;
  background: rgba(255,255,255,.022);
  color: var(--text);
  text-align: left;
  cursor: pointer;
}

.workspace-attempt-options button:hover,
.workspace-attempt-options button.selected {
  border-color: rgba(255,255,255,.17);
  background: rgba(255,255,255,.065);
}

.workspace-attempt-options button > span {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  place-items: center;
  border-radius: 7px;
  background: rgba(255,255,255,.065);
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
}

.workspace-attempt-options button.selected > span {
  color: var(--accent);
}

.workspace-attempt-hint {
  margin-top: 12px;
  padding: 11px 13px;
  border-left: 2px solid var(--accent);
  border-radius: 0 8px 8px 0;
  background: rgba(255,255,255,.03);
}

.workspace-attempt-hint strong {
  font-size: 10px;
  text-transform: uppercase;
}

.workspace-attempt-hint p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.workspace-attempt-window-actions {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 15px;
}

.workspace-attempt-finished {
  padding: 18px 10px 5px;
  text-align: center;
}

.workspace-score-orb {
  display: grid;
  width: 100px;
  height: 100px;
  margin: 0 auto 18px;
  place-items: center;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 50%;
  background: radial-gradient(circle,rgba(255,255,255,.08),transparent 65%);
  color: var(--accent);
  font-size: 30px;
  font-weight: 700;
}

.workspace-attempt-finished h3 {
  margin: 6px 0;
  font-size: 22px;
}

.workspace-attempt-finished p {
  color: var(--muted);
  margin-bottom: 20px;
}

@media (max-width: 850px) {
  .workspace-shell {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,.065);
  }

  .workspace-sidebar-footer {
    display: none;
  }

  .workspace-stat-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .workspace-hero,
  .workspace-main-header,
  .workspace-section-heading,
  .workspace-command-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .workspace-main {
    padding: 17px 13px;
  }

  .workspace-question-grid,
  .workspace-quick-grid,
  .workspace-stat-grid {
    grid-template-columns: 1fr;
  }

  .workspace-compute-row {
    align-items: stretch;
    flex-direction: column;
  }

  .workspace-gemini-status {
    flex: none;
  }

  .workspace-attempt-overlay {
    padding: 9px;
  }

  .workspace-attempt-window {
    max-height: calc(100dvh - 18px);
    padding: 18px;
    border-radius: 16px;
  }

  .workspace-attempt-window-actions {
    flex-direction: column;
  }
}
